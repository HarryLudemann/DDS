# Copy this file to `.env` and fill from Firebase Console → Project settings → Your apps.
# Never commit `.env`. Vite only reads these at `npm run dev` / `npm run build` startup.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
